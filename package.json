{
  "name": "the-well",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ador/feature-accounts": "workspace:*",
    "@ador/feature-creator-admission": "workspace:*",
    "@ador/feature-platform-shell": "workspace:*",
    "@ador/feature-public-products": "workspace:*",
    "@ador/feature-wallet-connection": "workspace:*",
    "@ador/feature-uploads": "workspace:*",
    "@ador/http": "workspace:*",
    "@ador/plugin-kit": "workspace:*",
    "@ador/provider-object-storage-r2": "workspace:*",
    "@ador/shared": "workspace:*",
    "@ador/wallet": "workspace:*",
    "@repo/config": "workspace:*"
  },
  "scripts": {
    "build": "pnpm decision:check && pnpm contracts:typecheck && turbo run build",
    "contracts:coverage": "cargo llvm-cov --manifest-path contracts/Cargo.toml --workspace --all-targets --fail-under-lines 90 --fail-under-functions 90 --fail-under-regions 90 && cargo llvm-cov report --manifest-path contracts/Cargo.toml --lcov --output-path contracts/target/llvm-cov-target/lcov.info",
    "contracts:lint": "cargo fmt --manifest-path contracts/Cargo.toml --all -- --check && cargo clippy --manifest-path contracts/Cargo.toml --workspace --all-targets -- -D warnings",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml --workspace --all-targets && CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER=wasm-bindgen-test-runner cargo test --manifest-path contracts/Cargo.toml --workspace --target wasm32-unknown-unknown --test claimant_authorization",
    "contracts:typecheck": "cargo check --manifest-path contracts/Cargo.toml --workspace --all-targets",
    "decision:check": "pnpm --filter @repo/repository-policy check:decisions",
    "db:check": "pnpm env:check && pnpm --filter @ador/database migration:check",
    "db:generate": "pnpm env:check && pnpm --filter @ador/database migration:generate",
    "db:migrate": "pnpm env:check && node --env-file-if-exists=apps/web/.env.local --experimental-strip-types packages/database/scripts/migrate.ts",
    "dev": "turbo run dev",
    "env:check": "turbo run env:check",
    "lint": "turbo run lint && pnpm contracts:lint && pnpm repository:check",
    "migration:check": "turbo run migration:check",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "typecheck": "turbo run typecheck && pnpm contracts:typecheck",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration --concurrency=2 && pnpm contracts:test",
    "test:coverage": "turbo run test:coverage --concurrency=2 && pnpm contracts:coverage && pnpm repository:coverage",
    "test:e2e": "pnpm build && pnpm --filter @repo/e2e test:e2e",
    "repository:check": "pnpm --filter @repo/repository-policy check",
    "repository:coverage": "pnpm --filter @repo/repository-policy check:coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@sats-connect/core>axios": "1.20.0",
      "alkanes": "https://codeload.github.com/kungfuflex/alkanes/tar.gz/7a3326b12702c044424d10b37c048e06ebefb3d2",
      "alkanes>bip32": "5.0.1",
      "body-parser>qs": "6.16.0",
      "express>qs": "6.16.0",
      "vite-plugin-ssr>esbuild": "0.28.2",
      "flatted": "3.4.2",
      "nanoid@3": "3.3.18",
      "picomatch@2": "2.3.2"
    }
  }
}
