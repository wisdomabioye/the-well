{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node --experimental-strip-types scripts/start-standalone.ts",
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "pnpm --filter @repo/e2e test:e2e"
  },
  "dependencies": {
    "@ador/auth": "workspace:*",
    "@ador/authorization": "workspace:*",
    "@ador/database": "workspace:*",
    "@ador/feature-accounts": "workspace:*",
    "@ador/feature-creator-admission": "workspace:*",
    "@ador/feature-platform-shell": "workspace:*",
    "@ador/feature-public-products": "workspace:*",
    "@ador/http": "workspace:*",
    "@ador/plugin-kit": "workspace:*",
    "@ador/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/config": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
