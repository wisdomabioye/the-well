# Runtime environment; independent from the hosting provider.
APP_ENV=test
# Canonical origin used for links and redirects.
PUBLIC_BASE_URL=http://localhost:3000
# Product name safe to expose in browser bundles.
NEXT_PUBLIC_APP_NAME=Adorbitals Test
# Disposable PostgreSQL test URL; the integration harness overrides this value.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app_test
# Optional privileged direct migration URL. Blank falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Disposable local PostgreSQL TLS policy.
DATABASE_SSL_MODE=disable
# Maximum test connections per process.
DATABASE_POOL_MAX=4
# Maximum milliseconds to acquire a PostgreSQL connection.
DATABASE_ACQUIRE_TIMEOUT_MS=5000
# Milliseconds before an idle pooled connection is closed.
DATABASE_IDLE_TIMEOUT_MS=1000
# Maximum PostgreSQL statement execution time in milliseconds.
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Cloudflare R2 S3 API HTTPS endpoint used by deployment qualification.
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# S3 signing region configured for the R2 account.
R2_REGION=auto
# Disposable test credentials supplied by the test environment.
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
# Isolated test buckets; never point these at production buckets.
R2_PRIVATE_BUCKET=ador-test-drafts
R2_PUBLIC_BUCKET=ador-test-public
# Sliding idle lifetime for authenticated platform sessions in milliseconds.
AUTH_SESSION_IDLE_TIMEOUT_MS=86400000
# Absolute lifetime for authenticated platform sessions in milliseconds.
AUTH_SESSION_ABSOLUTE_TIMEOUT_MS=604800000
# Maximum passkey registration ceremony lifetime in milliseconds.
PASSKEY_CHALLENGE_TIMEOUT_MS=300000
# Maximum authentication age allowed for passkey changes in milliseconds.
PASSKEY_RECENT_AUTH_WINDOW_MS=600000
