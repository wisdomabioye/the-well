{
  "name": "@ador/feature-uploads",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/registration.ts",
    "./entrypoint": "./src/entrypoint.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@ador/database": "workspace:*",
    "@ador/http": "workspace:*",
    "@ador/object-storage": "workspace:*",
    "@ador/plugin-kit": "workspace:*",
    "@ador/shared": "workspace:*",
    "@ador/uploads": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
