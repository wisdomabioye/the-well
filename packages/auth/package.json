{
  "name": "@ador/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bitcoin": "./src/bitcoin/verifier.ts",
    "./contracts": "./src/domain/contracts.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:check": "node --experimental-strip-types ../config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "node --experimental-strip-types ../database/test/support/run-postgres.ts integration",
    "test:coverage": "node --experimental-strip-types ../database/test/support/run-postgres.ts coverage"
  },
  "dependencies": {
    "@ador/database": "workspace:*",
    "@ador/chain": "workspace:*",
    "@ador/shared": "workspace:*",
    "bip322-js": "4.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
